---
import Icon from './Icon.astro';
interface Props {
  href?: string;
  label?: string;
}
const { href, label = 'View source' } = Astro.props;
---

{
  href ? (
    <a class="source-link" href={href} target="_blank" rel="noopener noreferrer">
      {label}
      <Icon name="arrow" size={16} />
    </a>
  ) : (
    <span class="private-badge">Private contract repository</span>
  )
}
