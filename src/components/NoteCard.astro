---
import type { CollectionEntry } from 'astro:content';
import { noteDate } from '../lib/notes';
interface Props {
  note: CollectionEntry<'notes'>;
}
const { note } = Astro.props;
---

<article class="note-card">
  <time datetime={note.data.published.toISOString()}>{noteDate(note.data.published)}</time>
  <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
  <p>{note.data.summary}</p>
  <div class="tags">{note.data.tags.map((tag) => <span>{tag}</span>)}</div>
</article>
