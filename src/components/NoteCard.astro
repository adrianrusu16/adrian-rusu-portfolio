---
import type { CollectionEntry } from 'astro:content';
import { noteDate } from '../lib/notes';
interface Props {
  note: CollectionEntry<'notes'>;
  headingLevel?: 'h2' | 'h3';
}
const { note, headingLevel: Heading = 'h3' } = Astro.props;
---

<article class="note-card">
  <time datetime={note.data.published.toISOString()}>{noteDate(note.data.published)}</time>
  <Heading><a href={`/notes/${note.id}/`}>{note.data.title}</a></Heading>
  <p>{note.data.summary}</p>
  <div class="tags">{note.data.tags.map((tag) => <span>{tag}</span>)}</div>
</article>
