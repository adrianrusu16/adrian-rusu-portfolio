---
import { getCollection } from 'astro:content';
import { identity } from '../data/identity';
interface Props {
  title: string;
  canonical: string;
}
const { title, canonical } = Astro.props;
const projects = (await getCollection('projects'))
  .filter((p) => p.data.repositoryVisibility === 'public' && p.data.repository)
  .map((p) => ({ slug: p.id, repository: p.data.repository! }));
const config = {
  pageLocation: canonical,
  pageTitle: title,
  projects,
  email: identity.email,
  linkedIn: identity.linkedIn,
  resume: identity.resume,
};
---

<section
  id="analytics-consent"
  class="consent-panel"
  role="region"
  aria-labelledby="analytics-title"
  data-config={JSON.stringify(config)}
  hidden
>
  <div>
    <h2 id="analytics-title">Optional analytics</h2>
    <p>
      With your permission, I use Google Analytics to understand how visitors find and use this
      portfolio. Advertising features stay off.
    </p>
    <p class="consent-status" role="status" aria-live="polite"></p>
  </div>
  <div class="consent-actions">
    <button type="button" data-consent="granted">Allow analytics</button>
    <button type="button" data-consent="denied">No thanks</button>
    <a href="/privacy/">Privacy</a>
  </div>
</section>

<script>
  import { createAnalytics, type Consent } from '../lib/analytics';
  const panel = document.querySelector<HTMLElement>('#analytics-consent');
  if (panel?.dataset.config) {
    const config = JSON.parse(panel.dataset.config) as {
      pageLocation: string;
      pageTitle: string;
      projects: { slug: string; repository: string }[];
      email: string;
      linkedIn: string;
      resume: string;
    };
    const status = panel.querySelector<HTMLElement>('.consent-status')!;
    const controls = document.querySelectorAll<HTMLButtonElement>('[data-analytics-settings]');
    let opener: HTMLButtonElement | undefined;
    function show(open: boolean) {
      panel!.hidden = !open;
      controls.forEach((button) => button.setAttribute('aria-expanded', String(open)));
    }
    const analytics = createAnalytics({
      ...config,
      projectSlugs: config.projects.map((p) => p.slug),
      onChange: (choice) => {
        show(choice === null);
      },
    });
    analytics.start();
    show(analytics.preference() === null);
    controls.forEach((button) =>
      button.addEventListener('click', () => {
        opener = button;
        status.textContent =
          analytics.preference() === 'granted'
            ? 'Analytics is currently allowed.'
            : 'Analytics is currently off.';
        show(true);
        panel.querySelector<HTMLButtonElement>('[data-consent]')?.focus();
      }),
    );
    panel.querySelectorAll<HTMLButtonElement>('[data-consent]').forEach((button) =>
      button.addEventListener('click', () => {
        const saved = analytics.choose(button.dataset.consent as Consent);
        if (!saved) {
          show(true);
          status.textContent =
            'Analytics is off for this page. Your browser could not save this choice. Check your browser storage settings to remember it.';
          return;
        }
        show(false);
        opener?.focus();
      }),
    );
    function intent(event: MouseEvent) {
      if (event.type === 'auxclick' && event.button !== 1) return;
      const anchor =
        event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (!anchor) return;
      const url = new URL(anchor.href, location.href);
      const clean = (url.origin + url.pathname).replace(/\/$/, '');
      if (url.protocol === 'mailto:' && url.pathname === config.email)
        analytics.track('contact_email_click');
      else if (url.origin === location.origin && url.pathname === config.resume)
        analytics.track('resume_download');
      else if (clean === config.linkedIn.replace(/\/$/, '')) analytics.track('linkedin_click');
      else {
        const project = config.projects.find(
          (p) => clean === p.repository || clean.startsWith(p.repository + '/'),
        );
        if (project) analytics.track('project_source_click', project.slug);
      }
    }
    document.addEventListener('click', intent);
    document.addEventListener('auxclick', intent);
  }
</script>

<style>
  .consent-panel[hidden] {
    display: none;
  }
  .consent-panel {
    position: fixed;
    z-index: 90;
    bottom: 1rem;
    right: 1rem;
    left: 1rem;
    max-width: 48rem;
    margin-left: auto;
    padding: 1.25rem;
    background: var(--surface-high);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 12px 36px #0006;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
  }
  h2 {
    font-size: 1.1rem;
    margin-bottom: 0.45rem;
  }
  p {
    font-size: 0.9rem;
  }
  .consent-status:not(:empty) {
    margin-top: 0.5rem;
    color: var(--text);
  }
  .consent-actions {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1rem;
  }
  button {
    background: transparent;
    border: 1px solid var(--accent-light);
    border-radius: 4px;
    padding: 0.65rem 1rem;
    min-height: 44px;
    cursor: pointer;
  }
  button:hover {
    background: var(--surface);
  }
  a {
    color: var(--accent-light);
    padding: 0.65rem 0.25rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  @media (max-width: 480px) {
    .consent-panel {
      padding: 1rem;
    }
    .consent-actions {
      gap: 0.5rem;
    }
  }
</style>
