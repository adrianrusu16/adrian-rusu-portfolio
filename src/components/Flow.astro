---
interface Props {
  steps: { title: string; detail?: string }[];
  label: string;
}
const { steps, label } = Astro.props;
---

<ol class="flow" aria-label={label}>
  {
    steps.map((step) => (
      <li>
        <strong>{step.title}</strong>
        {step.detail && <small>{step.detail}</small>}
      </li>
    ))
  }
</ol>
